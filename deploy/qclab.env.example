# Copy to qclab.env, fill in, and keep it out of version control. Every process
# that runs QC Lab reads this: the web server and every manage.py command.

# Never set this to 1 in production.
DJANGO_DEBUG=0

# python -c "import secrets; print(secrets.token_urlsafe(60))"
DJANGO_SECRET_KEY=

# The address people use, without https://
DJANGO_ALLOWED_HOSTS=qclab.example.com
# The same address, with https://
DJANGO_CSRF_TRUSTED_ORIGINS=https://qclab.example.com

# nginx sits in front and sets the forwarded headers. See nginx-qclab.conf.
QCLAB_BEHIND_PROXY=1

# The application's own login. It can read and write rows and nothing else.
# Migrations run as the owner login instead: see create_roles.sql.
POSTGRES_DB=qclab
POSTGRES_USER=qclab_app
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# The web server keeps a small pool of open database connections (opening one takes
# 60 to 300 ms on Windows). Set to 0 only to rule the pool out when chasing a fault.
# QCLAB_DB_POOL=1
# The web server also runs a background worker that sends email and sweeps for due
# dates. Set to 0 only if you run `deploy/run.py send_due_alerts` from a scheduler.
# QCLAB_BACKGROUND=1

# Uploaded files. Back this folder up with the database.
QCLAB_MEDIA_ROOT=

# Sign-in rules. These are the shipped values: change them only under an SOP.
QCLAB_IDLE_MINUTES=15
QCLAB_PASSWORD_MAX_AGE_DAYS=180

# Email. Leave QCLAB_EMAIL_HOST out to keep alerts in the app only.
QCLAB_EMAIL_HOST=smtp.example.com
QCLAB_EMAIL_PORT=587
QCLAB_EMAIL_USER=qclab@example.com
QCLAB_EMAIL_PASSWORD=
QCLAB_EMAIL_TLS=1
QCLAB_EMAIL_FROM=QC Lab <qclab@example.com>
# How links in an email begin. Blank leaves links out.
QCLAB_BASE_URL=https://qclab.example.com
